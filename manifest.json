{
  "schemaVersion": 1,
  "id": "stappmus.activity-monitor",
  "name": "Activity Monitor",
  "version": "2.2.0",
  "author": "Kristoffer Haugland",
  "license": "MIT",
  "description": "A calm, low-overhead glance at CPU, memory, GPU, storage, and processes — with a die that matches your chip",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Activity Monitor",
    "description": "A calm system glance with an expandable process view and a CPU die that matches your hardware.",
    "category": "System",
    "aliases": [
      "activity",
      "system-monitor",
      "btop"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "samplingSpeed": "Balanced",
      "historySamples": 60,
      "temperatureUnit": "Celsius",
      "showFrequencies": true,
      "openExpanded": false,
      "processPowerEnabled": true,
      "barGraph": "Off",
      "barGraphLength": 0
    },
    "schema": [
      {
        "key": "samplingSpeed",
        "type": "enum",
        "label": "Update speed",
        "options": [
          "Efficient",
          "Balanced",
          "Fast"
        ],
        "defaultValue": "Balanced",
        "description": "Efficient uses fewer samples; Fast makes the graphs react sooner."
      },
      {
        "key": "historySamples",
        "type": "integer",
        "label": "History samples",
        "min": 20,
        "max": 240,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "temperatureUnit",
        "type": "enum",
        "label": "Temperature unit",
        "options": [
          "Celsius",
          "Fahrenheit"
        ],
        "defaultValue": "Celsius"
      },
      {
        "key": "barGraph",
        "type": "enum",
        "label": "Bar graph",
        "options": [
          "Off",
          "CPU",
          "Memory"
        ],
        "defaultValue": "Off",
        "description": "Draw a live sparkline beside the bar icon. Off keeps sampling to while the panel is open."
      },
      {
        "key": "barGraphLength",
        "type": "integer",
        "label": "Bar graph width",
        "min": 0,
        "max": 160,
        "step": 2,
        "defaultValue": 0,
        "description": "Length of the bar graph along the bar, in pixels. 0 matches the bar thickness for a square graph."
      },
      {
        "key": "showFrequencies",
        "type": "boolean",
        "label": "Show hardware speeds",
        "defaultValue": true
      },
      {
        "key": "openExpanded",
        "type": "boolean",
        "label": "Open detailed view",
        "defaultValue": false
      },
      {
        "key": "processPowerEnabled",
        "type": "boolean",
        "label": "Process power estimates",
        "defaultValue": true,
        "description": "Disable to skip CPU package-energy sampling in the detailed view."
      }
    ]
  }
}

#!/bin/bash

# omarchy:summary=Print system activity stats for the shell
# omarchy:group=system
# omarchy:args=[--bar-widget|--activity-reader|--activity-resources|--activity-processes|--activity-thermals|--activity-gpus|--activity-process-power|--activity-process-power-reader|--activity-storage]

set -euo pipefail

readonly dir="${BASH_SOURCE[0]%/*}"

# Prefer the prebuilt sampler for this CPU, then a local `make` build.
helper="$dir/activity-sampler-$HOSTTYPE"
[[ -x $helper ]] || helper="$dir/activity-sampler"
[[ -x $helper ]] || exit 77
exec "$helper" "$@"
